{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A quote or post published on the site",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 5000
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "authorRole": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "maxLength": 100
        },
        "likes": {
          "type": "number"
        },
        "pinned": {
          "type": "boolean"
        },
        "copiesCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending"]
        }
      },
      "required": ["title", "content", "authorName", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A message submitted in the live chat section",
      "type": "object",
      "properties": {
        "senderName": {
          "type": "string",
          "maxLength": 100
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "timestamp": {
          "type": "string",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["sent", "replied"]
        },
        "adminReply": {
          "type": "object"
        }
      },
      "required": ["senderName", "text", "timestamp", "status"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of quotes and posts displayed on the site"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Collection of live chat questions and responses"
    }
  }
}
